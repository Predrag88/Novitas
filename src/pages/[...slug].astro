---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import VideoCard from '../components/VideoCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const videos = page.data.videos ?? [];
---

<Layout title={`${page.data.title} — Novitas.rs`} description={page.data.description}>
  {videos.length > 0 ? (
    <Section>
      <p class="eyebrow">Dokumentarni serijal</p>
      <h1 class="mt-4 mb-4 font-display text-3xl tracking-tight text-ink sm:text-4xl">{page.data.title}</h1>
      <p class="max-w-xl leading-relaxed text-ink/65">{page.data.description}</p>

      <ul class="mt-12 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map((video) => (
          <VideoCard name={video.name} url={video.url} />
        ))}
      </ul>
    </Section>
  ) : (
    <Section narrow>
      <article>
        <h1 class="mb-8 font-display text-3xl tracking-tight text-ink sm:text-4xl">{page.data.title}</h1>

        {page.data.heroImage && (
          <div class="mb-10 overflow-hidden rounded-2xl">
            <img src={page.data.heroImage} alt={page.data.title} class="w-full object-cover" />
          </div>
        )}

        <div class="prose prose-neutral max-w-none prose-headings:font-display prose-a:text-primary prose-a:no-underline hover:prose-a:underline">
          <Content />
        </div>
      </article>
    </Section>
  )}
</Layout>
