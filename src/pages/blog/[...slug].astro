---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('sr-Latn-RS', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${post.data.title} — Vidljiva.rs`} description={post.data.description}>
  <Section narrow>
    <a href="/blog/" class="story-link inline-flex items-center gap-1.5 text-sm text-ink/55 hover:text-ink">
      ← Nazad na listu
    </a>

    <article class="mt-8">
      <header class="mb-8">
        <div class="mb-3 flex items-center gap-3 text-xs text-ink/45">
          <span>{dateFormatter.format(post.data.pubDate)}</span>
          {post.data.category && (
            <>
              <span class="h-1 w-1 rounded-full bg-ink/20"></span>
              <span class="font-semibold uppercase tracking-wide text-primary">{post.data.category}</span>
            </>
          )}
        </div>
        <h1 class="font-display text-3xl tracking-tight text-ink sm:text-4xl">{post.data.title}</h1>
      </header>

      {post.data.heroImage && (
        <div class="mb-10 overflow-hidden rounded-2xl">
          <img src={post.data.heroImage} alt={post.data.title} class="w-full object-cover" />
        </div>
      )}

      <div class="prose prose-neutral max-w-none prose-headings:font-display prose-a:text-primary prose-a:no-underline hover:prose-a:underline">
        <Content />
      </div>
    </article>

    <a href="/blog/" class="story-link mt-12 inline-flex items-center gap-1.5 text-sm text-ink/55 hover:text-ink">
      ← Nazad na listu
    </a>
  </Section>
</Layout>
