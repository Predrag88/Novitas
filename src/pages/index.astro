---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

// Klijent bira šta je izdvojeno na početnoj kroz "★ Izdvojeno na početnoj" u CMS-u.
// Dok ništa nije ručno označeno, prikazuju se 2 najnovija članka iz kategorije "Radionice".
let workshopPosts = (await getCollection('blog', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

if (workshopPosts.length === 0) {
  workshopPosts = (await getCollection('blog', ({ data }) => !data.draft && data.category === 'Radionice'))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 2);
}

const stats = [
  { value: '30%', text: 'žena u lokalnim medijima predstavljeno je u stereotipnim ulogama, poput majki.' },
  { value: '1/5', text: 'gostiju i eksperata u političkim emisijama lokalnih medija su žene.' },
  { value: '60%', text: 'žena u lokalnim medijima pojavljuje se kroz kulturu, obrazovanje i zdravstvo.' },
  { value: '12/20', text: 'učesnica radionica izrazilo je nezadovoljstvo vidljivošću žena u medijima.' },
];
---

<Layout title="Vidljiva.rs — Podrška medijskoj vidljivosti žena">
  <!-- HERO -->
  <Section class="pb-0 pt-14 sm:pt-16" containerClass="grid grid-cols-1 items-center gap-12 lg:grid-cols-[1fr_0.9fr] lg:gap-16">
    <div>
      <p class="eyebrow">Dokumentarni serijal &amp; radionice</p>
      <h1 class="mt-5 font-display text-4xl leading-[1.08] tracking-tight text-ink sm:text-5xl">
        Novitas
      </h1>
      <p class="mt-5 max-w-md text-lg leading-relaxed text-ink/65">
        Podrška osnaživanju i većoj vidljivosti žena u medijima Pirotskog okruga.
      </p>
      <a href="/dokumentarni-serijal/" class="btn mt-8">Pogledaj serijal</a>
    </div>
    <div class="overflow-hidden rounded-2xl">
      <img
        src="/images/posts/vidljivahomebanner003.jpg"
        alt="Vidljiva — dokumentarni serijal"
        class="h-72 w-full object-cover sm:h-96"
      />
    </div>
  </Section>

  <!-- FUNDING NOTICE -->
  <Section class="py-8" as="div">
    <div class="border-y border-line py-6">
      <p class="mx-auto max-w-3xl text-center text-sm leading-relaxed text-ink/60">
        Projekat „Žene u fokusu - podrška medijskoj vidljivosti!“ se realizuje u okviru Programa malih
        medijskih grantova koji finansira Ambasada SAD, a administrira Media i Reform Centar Niš. Stavovi,
        mišljenja i zaključci izneseni u projektu nužno ne izražavaju stavove MRCN i Ambasade SAD već
        isključivo autora.
      </p>
    </div>
  </Section>

  <!-- O PROJEKTU -->
  <Section containerClass="grid grid-cols-1 items-center gap-12 sm:grid-cols-2 sm:gap-16">
    <div class="order-2 overflow-hidden rounded-2xl sm:order-1">
      <img
        src="/images/posts/vidljivahomebanner3.jpg"
        alt="O projektu"
        class="h-72 w-full object-cover sm:h-96"
      />
    </div>
    <div class="order-1 sm:order-2">
      <p class="eyebrow">O projektu</p>
      <h2 class="mt-4 font-display text-3xl tracking-tight text-ink">Zašto ovaj projekat postoji</h2>
      <p class="mt-5 leading-relaxed text-ink/65">
        Projekat „Žene u fokusu — podrška medijskoj vidljivosti“ adresira nedostatak zastupljenosti žena
        u medijima, posebno u manjim sredinama poput Pirotskog okruga. Kroz dokumentarni serijal
        „VIDLJIVA“, ističemo ženske priče i izazove u lokalnoj zajednici. Projekat uključuje radionice i
        javnu tribinu kako bi osnažio žene da se izraze.
      </p>
      <a href="/zene-u-fokusu-podrska-medijskoj-vidljivosti/" class="story-link mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
        Saznaj više <span aria-hidden="true">→</span>
      </a>
    </div>
  </Section>

  <!-- STATS -->
  <Section class="border-y border-line bg-ink/[0.02]">
    <p class="eyebrow">Zašto je ovo važno</p>
    <ul class="mt-8 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4">
      {stats.map((s) => (
        <li class="border-l border-line pl-5">
          <p class="font-display text-4xl tracking-tight text-ink sm:text-5xl">{s.value}</p>
          <p class="mt-3 text-sm leading-relaxed text-ink/60">{s.text}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- RADIONICE INVITE -->
  <Section containerClass="grid grid-cols-1 items-center gap-12 sm:grid-cols-2 sm:gap-16">
    <div class="overflow-hidden rounded-2xl sm:order-2">
      <img
        src="/images/posts/slika2.jpg"
        alt="Radionice za medijsko osnaživanje žena"
        class="h-72 w-full object-cover sm:h-96"
      />
    </div>
    <div class="sm:order-1">
      <p class="eyebrow">Prijave otvorene</p>
      <h2 class="mt-4 font-display text-3xl tracking-tight text-ink">
        Radionice za medijsko osnaživanje žena
      </h2>
      <p class="mt-5 leading-relaxed text-ink/65">
        Pozivamo sve zainteresovane žene da se prijave za radionice koje organizujemo sa ciljem
        informisanja, sticanja i unapređenja veština žena u komunikaciji sa medijima. Ciljane oblasti:
        aktivizam i civilno društvo, privreda, zdravstvo i socijalna politika, kultura i obrazovanje i
        životna sredina. Broj učesnica je ograničen.
      </p>
      <a href="mailto:novitas.razvoj@gmail.com" class="btn mt-8">novitas.razvoj@gmail.com</a>
    </div>
  </Section>

  <!-- RADIONICE POSTS -->
  <Section>
    <div class="mb-10 flex items-end justify-between gap-4">
      <h2 class="font-display text-2xl tracking-tight text-ink">Radionice</h2>
      <a href="/kategorija/radionice/" class="story-link text-sm font-semibold text-primary">
        Pogledaj sve →
      </a>
    </div>
    <ul class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2">
      {workshopPosts.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          heroImage={post.data.heroImage}
        />
      ))}
    </ul>
  </Section>
</Layout>
