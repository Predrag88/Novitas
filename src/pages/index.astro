---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('sr-RS', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title="Vidljiva.rs — Blog">
  <h1 class="mb-8 text-3xl font-bold tracking-tight">Blog</h1>

  <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2">
    {
      posts.map((post) => (
        <li class="group overflow-hidden rounded-lg border border-slate-200 transition hover:shadow-md">
          <a href={`/blog/${post.id}/`} class="block">
            {post.data.heroImage && (
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="h-48 w-full object-cover"
                loading="lazy"
              />
            )}
            <div class="p-5">
              <p class="mb-2 text-xs uppercase tracking-wide text-slate-500">
                {dateFormatter.format(post.data.pubDate)}
              </p>
              <h2 class="mb-2 text-lg font-semibold leading-snug group-hover:underline">
                {post.data.title}
              </h2>
              <p class="line-clamp-3 text-sm text-slate-600">{post.data.description}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
