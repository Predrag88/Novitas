---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
---

<Layout title="Stranica nije pronađena — Novitas.rs">
  <Section narrow class="text-center">
    <p class="eyebrow">Greška 404</p>
    <h1 class="mt-4 font-display text-4xl tracking-tight text-ink sm:text-5xl">Stranica ne postoji</h1>
    <p class="mx-auto mt-5 max-w-md leading-relaxed text-ink/65">
      Stranica koju tražite je možda premeštena ili više ne postoji. Proverite adresu ili se vrati na
      početnu.
    </p>
    <a href="/" class="btn mt-8">Nazad na početnu</a>
  </Section>
</Layout>
