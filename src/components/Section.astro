---
interface Props {
  class?: string;
  containerClass?: string;
  narrow?: boolean;
  as?: 'section' | 'div';
}

const { class: className = '', containerClass = '', narrow = false, as: Tag = 'section' } = Astro.props;
---

<Tag class:list={['py-16 sm:py-24', className]}>
  <div class:list={['mx-auto px-6', narrow ? 'max-w-2xl' : 'max-w-6xl', containerClass]}>
    <slot />
  </div>
</Tag>
