---
import '../styles/global.css';
import { CATEGORIES } from '../lib/categories';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Vidljiva.rs — blog o medijskoj vidljivosti žena.' } = Astro.props;

const navLinks = [
  { href: '/blog/', label: 'Blog' },
  ...CATEGORIES.filter((c) => c.name !== 'Radionice').map((c) => ({
    href: `/kategorija/${c.slug}/`,
    label: c.name,
  })),
  { href: '/dokumentarni-serijal/', label: 'Dokumentarni serijal' },
  { href: '/o-nama/', label: 'O nama' },
  { href: '/anketa/', label: 'Anketa' },
  { href: '/contact/', label: 'Kontakt' },
];
---

<!doctype html>
<html lang="sr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900">
    <header class="border-b border-slate-200">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-8 gap-y-3 px-4 py-5">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/logo-novitas.png" alt="Novitas" class="h-10 w-auto" />
          <span class="text-lg font-semibold tracking-tight text-primary">Vidljiva.rs</span>
        </a>
        <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600">
          <a href="/" class="hover:text-secondary">Početna</a>
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-secondary">{link.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-primary-dark text-white">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-white/70">
        © {new Date().getFullYear()} Vidljiva.rs — Centar za razvojnu podršku i inicijativu NOVITAS
      </div>
    </footer>
  </body>
</html>
